# Application Identifier (used for Firestore namespace isolation)
APP_NAME=multi_agent_starter

# Set to true for quick local testing without Firebase Authentication
MOCK_AUTH=false

# Gemini API Key for Google ADK / GenAI
GOOGLE_API_KEY=your_gemini_api_key_here

# Director & Sub-Agent Models (optional overrides)
DIRECTOR_MODEL=gemini-3.1-pro-preview
SEARCH_MODEL=gemini-3.8-flash
RESEARCHER_MODEL=gemini-3.8-flash

# Optional External Tool Integrations (e.g., Zapier MCP)
ZAPIER_MCP_URL=

# Multi-Model Provider API Keys (optional server fallbacks)
# Default is Google Gemini (GOOGLE_API_KEY above)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Optional Custom Service API Keys
# CUSTOM_SERVICE_KEY=your_api_key_here

